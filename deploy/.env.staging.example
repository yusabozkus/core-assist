RELEASE_TAG=staging-replace-with-commit-sha
DEPLOYMENT_ENV=staging
# Replace with a staging domain outside the production cookie domain.
WEB_DOMAIN=staging.example.net
API_DOMAIN=api.staging.example.net
AUTH_COOKIE_DOMAIN=staging.example.net
ACME_EMAIL=ops@coreasistan.com
PADDLE_ENV=sandbox
# Public sandbox client token only; never put a Paddle API key here.
PADDLE_CLIENT_TOKEN=replace-with-sandbox-public-token
SECRETS_DIR=./deploy/secrets/staging
BACKUP_DIR=/var/backups/core-assist-staging
# Public age recipient for this environment's recovery key.
AGE_RECIPIENT=
