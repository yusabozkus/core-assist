RELEASE_TAG=20260927-1
DEPLOYMENT_ENV=production
WEB_DOMAIN=coreasistan.com
API_DOMAIN=api.coreasistan.com
AUTH_COOKIE_DOMAIN=coreasistan.com
ACME_EMAIL=ops@coreasistan.com
PADDLE_ENV=production
# Public client token only; never put a Paddle API key here.
PADDLE_CLIENT_TOKEN=replace-with-live-public-token
SECRETS_DIR=./deploy/secrets
BACKUP_DIR=/var/backups/core-assist
# Public age recipient; keep the private recovery identity off this VDS.
AGE_RECIPIENT=
