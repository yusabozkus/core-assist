{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "check": "npm run lint && npm test && npm run build",
    "repair:answer": "node dist/src/scripts/review-answer-delivery.js",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "smoke:catalog-sync": "npm run build && node dist/src/scripts/catalog-sync-smoke.js",
    "smoke:question-sync": "npm run build && node dist/src/scripts/question-sync-smoke.js",
    "smoke:gemini": "npm run build && node dist/src/scripts/gemini-smoke.js",
    "simulate:questions": "npm run build && node dist/src/scripts/simulate-incoming-questions.js",
    "seed:demo": "npm run build && node dist/src/scripts/seed-realistic-demo.js",
    "benchmark:questions:seed": "npm run build && node dist/src/scripts/question-performance-benchmark.js seed",
    "benchmark:questions:explain": "npm run build && node dist/src/scripts/question-performance-benchmark.js explain",
    "benchmark:questions:clean": "npm run build && node dist/src/scripts/question-performance-benchmark.js clean",
    "eval:answer-context": "npm run build && node dist/src/scripts/answer-reliability-eval.js",
    "eval:ai-drafts": "npm run build && node dist/src/scripts/answer-reliability-eval.js --with-ai",
    "eval:ai-targeted": "npm run build && node dist/src/scripts/answer-reliability-eval.js --with-ai --targeted-only",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio --port 5556"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@google/genai": "^2.19.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "11.2.6",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "^1.7.2",
    "bullmq": "^6.3.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "ioredis": "^6.0.0",
    "pg": "^8.13.3",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "tldts": "7.4.15",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "@prisma/config@7.10.0": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma@7.10.0": {
      "mysql2": "3.24.4"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.11",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
