datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

model User {
  id                       String            @id @default(uuid())
  name                     String
  email                    String            @unique
  emailVerified            Boolean           @default(false)
  image                    String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  sessions                 Session[]
  accounts                 Account[]
  ownedWorkspaces          Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers         WorkspaceMember[]
  storeMembers             StoreMember[]
  requestedQuestionAnswers QuestionAnswer[]  @relation("QuestionAnswerRequester")

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members WorkspaceMember[]
  stores  Store[]

  @@map("workspace")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_member")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Store {
  id          String      @id @default(uuid())
  workspaceId String
  name        String
  timezone    String      @default("Europe/Istanbul")
  status      StoreStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members            StoreMember[]
  channelConnections ChannelConnection[]
  products           Product[]
  incomingEvents     IncomingEvent[]
  productQuestions   ProductQuestion[]
  questionAnswers    QuestionAnswer[]

  @@map("store")
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

enum ChannelType {
  COMMERCE
  MESSAGING
  SOCIAL
}

enum ChannelConnectionStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  ERROR
}

enum IntegrationEnvironment {
  SANDBOX
  PRODUCTION
}

model ChannelConnection {
  id                        String                  @id @default(uuid())
  storeId                   String
  providerKey               String                  @map("provider")
  type                      ChannelType
  environment               IntegrationEnvironment  @default(SANDBOX)
  status                    ChannelConnectionStatus @default(PENDING)
  credentialsEncrypted      String?
  credentialSchemaVersion   Int                     @default(1)
  connectedAt               DateTime?
  processingStartedAt       DateTime?
  lastSyncAt                DateTime?
  lastInventorySyncAt       DateTime?
  failureReason             String?
  questionSyncStartedAt     DateTime?
  lastQuestionSyncAt        DateTime?
  questionSyncFailureReason String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  externalProducts ExternalProduct[]
  syncRuns         CatalogSyncRun[]
  incomingEvents   IncomingEvent[]
  productQuestions ProductQuestion[]
  questionAnswers  QuestionAnswer[]

  @@unique([storeId, providerKey])
  @@index([storeId, status])
  @@map("channel_connection")
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum ProductVariantStatus {
  ACTIVE
  OUT_OF_STOCK
  UNAVAILABLE
  ARCHIVED
}

model Product {
  id          String        @id @default(uuid())
  storeId     String
  title       String
  description String?
  brand       String?
  category    String?
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  store            Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants         ProductVariant[]
  attributes       ProductAttribute[]
  images           ProductImage[]
  externalProducts ExternalProduct[]
  questions        ProductQuestion[]

  @@index([storeId, status])
  @@map("product")
}

model ProductVariant {
  id              String               @id @default(uuid())
  productId       String
  title           String?
  sku             String
  barcode         String?
  color           String?
  size            String?
  price           Decimal              @db.Decimal(12, 2)
  currency        String               @default("TRY")
  stock           Int                  @default(0)
  status          ProductVariantStatus @default(ACTIVE)
  sourceUpdatedAt DateTime?
  lastSyncedAt    DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  product          Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  externalVariants ExternalProductVariant[]

  @@unique([productId, sku])
  @@index([barcode])
  @@map("product_variant")
}

model ProductAttribute {
  id        String   @id @default(uuid())
  productId String
  name      String
  value     String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name, value])
  @@map("product_attribute")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, url])
  @@map("product_image")
}

model ExternalProduct {
  id              String               @id @default(uuid())
  connectionId    String
  productId       String
  externalId      String
  externalUrl     String?
  rawPayload      Json?
  status          ExternalEntityStatus @default(ACTIVE)
  lastSeenSyncId  String?
  sourceUpdatedAt DateTime?
  lastSyncedAt    DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  connection ChannelConnection        @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  product    Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants   ExternalProductVariant[]
  questions  ProductQuestion[]

  @@unique([connectionId, externalId])
  @@index([productId])
  @@map("external_product")
}

enum ExternalEntityStatus {
  ACTIVE
  ARCHIVED
  UNAVAILABLE
}

model ExternalProductVariant {
  id                String               @id @default(uuid())
  externalProductId String
  productVariantId  String
  externalId        String
  sku               String
  barcode           String?
  status            ExternalEntityStatus @default(ACTIVE)
  lastSeenSyncId    String?
  sourceUpdatedAt   DateTime?
  lastSyncedAt      DateTime             @default(now())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  externalProduct ExternalProduct @relation(fields: [externalProductId], references: [id], onDelete: Cascade)
  productVariant  ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([externalProductId, externalId])
  @@index([productVariantId])
  @@index([barcode])
  @@index([sku])
  @@map("external_product_variant")
}

enum CatalogSyncStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum CatalogSyncKind {
  FULL
  INVENTORY
}

model CatalogSyncRun {
  id                String            @id @default(uuid())
  connectionId      String
  kind              CatalogSyncKind   @default(FULL)
  status            CatalogSyncStatus @default(RUNNING)
  productsProcessed Int               @default(0)
  variantsProcessed Int               @default(0)
  productsArchived  Int               @default(0)
  cursor            String?
  errorMessage      String?
  startedAt         DateTime          @default(now())
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
  @@map("catalog_sync_run")
}

enum IncomingEventType {
  PRODUCT_QUESTION
}

enum IncomingEventProcessingStatus {
  PENDING
  PROCESSED
  IGNORED
  FAILED
}

model IncomingEvent {
  id                String                        @id @default(uuid())
  storeId           String
  connectionId      String
  externalEventId   String
  eventType         IncomingEventType
  externalCreatedAt DateTime
  receivedAt        DateTime                      @default(now())
  processingStatus  IncomingEventProcessingStatus @default(PENDING)
  ignoreReason      String?
  errorMessage      String?
  payload           Json
  processedAt       DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  question   ProductQuestion?

  @@unique([connectionId, externalEventId])
  @@index([storeId, processingStatus, receivedAt])
  @@index([connectionId, externalCreatedAt])
  @@map("incoming_event")
}

enum ProductQuestionStatus {
  PENDING
  DRAFTED
  ANSWERED
  IGNORED
}

enum QuestionAnswerStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
}

model ProductQuestion {
  id                      String                @id @default(uuid())
  storeId                 String
  connectionId            String
  incomingEventId         String                @unique
  productId               String?
  externalProductRecordId String?
  externalQuestionId      String
  externalProductId       String
  externalCustomerId      String?
  customerName            String?
  question                String
  status                  ProductQuestionStatus @default(PENDING)
  answer                  String?
  externalCreatedAt       DateTime
  answeredAt              DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connection      ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  incomingEvent   IncomingEvent     @relation(fields: [incomingEventId], references: [id], onDelete: Cascade)
  product         Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  externalProduct ExternalProduct?  @relation(fields: [externalProductRecordId], references: [id], onDelete: SetNull)
  answerDelivery  QuestionAnswer?

  @@unique([connectionId, externalQuestionId])
  @@index([storeId, status, externalCreatedAt])
  @@index([productId])
  @@index([externalProductRecordId])
  @@map("product_question")
}

model QuestionAnswer {
  id                  String               @id @default(uuid())
  storeId             String
  connectionId        String
  questionId          String               @unique
  requestedByUserId   String
  answer              String
  status              QuestionAnswerStatus @default(QUEUED)
  externalAnswerId    String?
  attempts            Int                  @default(0)
  lastError           String?
  queuedAt            DateTime             @default(now())
  processingStartedAt DateTime?
  sentAt              DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connection  ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  question    ProductQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  requestedBy User              @relation("QuestionAnswerRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([storeId, status, queuedAt])
  @@index([connectionId, status])
  @@map("question_answer")
}

model StoreMember {
  id        String    @id @default(uuid())
  storeId   String
  userId    String
  role      StoreRole @default(AGENT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@map("store_member")
}

enum StoreRole {
  OWNER
  ADMIN
  AGENT
  VIEWER
}
