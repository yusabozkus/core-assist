datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

model User {
  id                           String                        @id @default(uuid())
  name                         String
  email                        String                        @unique
  emailVerified                Boolean                       @default(false)
  image                        String?
  onboardingCompletedAt        DateTime?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  sessions                     Session[]
  accounts                     Account[]
  ownedWorkspace               Workspace?                    @relation("WorkspaceOwner")
  workspaceMembers             WorkspaceMember[]
  storeMembers                 StoreMember[]
  requestedQuestionAnswers     QuestionAnswer[]              @relation("QuestionAnswerRequester")
  requestedAiDrafts            AiDraftAttempt[]              @relation("AiDraftRequester")
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  notificationDeliverySettings NotificationDeliverySetting[]
  webPushSubscriptions         WebPushSubscription[]
  billingCheckouts              BillingCheckout[]
  billingPlanChanges            BillingPlanChange[]
  sentWorkspaceInvitations      WorkspaceInvitation[]         @relation("WorkspaceInvitationSender")

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  ownerId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner               User                 @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members             WorkspaceMember[]
  stores              Store[]
  billingSubscription BillingSubscription?
  billingUsagePeriods BillingUsagePeriod[]
  billingUsageEvents  BillingUsageEvent[]
  billingCheckouts    BillingCheckout[]
  billingPlanChanges  BillingPlanChange[]
  invitations         WorkspaceInvitation[]

  @@map("workspace")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@unique([workspaceId, userId])
  @@map("workspace_member")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model WorkspaceInvitation {
  id              String                    @id @default(uuid())
  workspaceId     String
  email           String
  emailNormalized String
  role            WorkspaceRole             @default(MEMBER)
  tokenHash       String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace    Workspace                        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy    User?                            @relation("WorkspaceInvitationSender", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  storeAccesses WorkspaceInvitationStoreAccess[]

  @@index([workspaceId, status, expiresAt])
  @@index([emailNormalized, status])
  @@map("workspace_invitation")
}

model WorkspaceInvitationStoreAccess {
  invitationId String
  storeId      String
  role         StoreRole @default(AGENT)
  createdAt    DateTime  @default(now())

  invitation WorkspaceInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  store      Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([invitationId, storeId])
  @@index([storeId])
  @@map("workspace_invitation_store_access")
}

enum BillingPlan {
  STARTER
  GROWTH
  BUSINESS
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum BillingSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}

enum BillingUsageMetric {
  AI_QUESTION
}

model BillingSubscription {
  id                   String                    @id @default(uuid())
  workspaceId          String                    @unique
  plan                 BillingPlan               @default(STARTER)
  cycle                BillingCycle              @default(MONTHLY)
  status               BillingSubscriptionStatus @default(TRIALING)
  paddleCustomerId     String?                   @unique
  paddleSubscriptionId String?                   @unique
  paddlePriceId        String?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  trialEndsAt          DateTime?
  cancelAtPeriodEnd    Boolean                   @default(false)
  canceledAt           DateTime?
  paddleUpdatedAt      DateTime?
  paddleSnapshotAt     DateTime?
  scheduledAccessEndsAt DateTime?
  lastReconciledAt     DateTime?
  reconcileAfter       DateTime                  @default(now())
  reconcileFailures    Int                       @default(0)
  reconcileErrorCode   String?
  usagePeriodAnchor    DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usagePeriods BillingUsagePeriod[]

  @@index([status, currentPeriodEnd])
  @@index([reconcileAfter])
  @@map("billing_subscription")
}

model BillingWebhookEvent {
  id          String   @id
  eventType   String
  occurredAt  DateTime
  processedAt DateTime @default(now())

  @@index([eventType, occurredAt])
  @@index([processedAt])
  @@map("billing_webhook_event")
}

// Minimal financial closure evidence survives account/workspace deletion.
// No user relation, profile, payment credentials, or raw Paddle payloads.
model BillingClosureRecord {
  id                    String            @id @default(uuid())
  workspaceReference    String            @unique
  environment           PaddleEnvironment
  paddleSubscriptionIds String[]
  paddleCustomerIds     String[]
  billingSnapshot       Json
  closedAt              DateTime          @default(now())

  @@index([paddleSubscriptionIds], type: Gin)
  @@map("billing_closure_record")
}

enum PaddleEnvironment {
  SANDBOX
  PRODUCTION
}

enum BillingCheckoutStatus {
  CREATING
  OPEN
  REVIEW_REQUIRED
  COMPLETED
  CANCELED
  FAILED
}

model BillingCheckout {
  id                          String            @id @default(uuid())
  workspaceId                 String
  requestedByUserId           String?
  environment                 PaddleEnvironment
  status                      BillingCheckoutStatus @default(CREATING)
  plan                        BillingPlan
  cycle                       BillingCycle
  paddlePriceId               String
  paddleTransactionId         String?           @unique
  expectedPaddleCustomerId     String?
  previousPaddleSubscriptionId String?
  paddleSubscriptionId        String?           @unique
  boundAt                     DateTime?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedByUser User?     @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([status, updatedAt])
  // A SQL partial unique index permits only one unresolved checkout per workspace.
  @@index([requestedByUserId])
  @@map("billing_checkout")
}

enum BillingPlanChangeStatus {
  PREVIEWED
  PROCESSING
  RETRY_SCHEDULED
  AWAITING_WEBHOOK
  COMPLETED
  FAILED
  REVIEW_REQUIRED
}

model BillingPlanChange {
  id                   String                  @id @default(uuid())
  workspaceId          String
  requestedByUserId    String?
  environment          PaddleEnvironment
  status               BillingPlanChangeStatus @default(PREVIEWED)
  paddleSubscriptionId String
  paddleCustomerId     String
  sourcePriceId        String
  sourceUpdatedAt      DateTime
  sourceFingerprint    String
  targetPriceId        String
  plan                 BillingPlan
  cycle                BillingCycle
  preview              Json
  expiresAt            DateTime
  submittedAt          DateTime?
  retryAfterSeconds    Int?
  retryAt              DateTime?
  retryCount           Int                     @default(0)
  completedAt          DateTime?
  failureCode          String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedByUser User?     @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([requestedByUserId])
  @@index([status, retryAt])
  @@index([status, expiresAt])
  @@index([status, updatedAt])
  // A partial unique index serializes submitted changes, not read-only previews.
  @@map("billing_plan_change")
}

model BillingUsagePeriod {
  id              String   @id @default(uuid())
  workspaceId     String
  subscriptionId  String?
  periodStart     DateTime
  periodEnd       DateTime
  aiQuestionUnits Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  events       BillingUsageEvent[]

  @@unique([workspaceId, periodStart])
  @@index([workspaceId, periodEnd])
  @@index([subscriptionId])
  @@map("billing_usage_period")
}

model BillingUsageEvent {
  id             String             @id @default(uuid())
  workspaceId    String
  usagePeriodId  String
  metric         BillingUsageMetric
  quantity       Int                @default(1)
  idempotencyKey String
  sourceType     String?
  sourceId       String?
  metadata       Json?
  createdAt      DateTime           @default(now())

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usagePeriod BillingUsagePeriod @relation(fields: [usagePeriodId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([usagePeriodId, metric, createdAt])
  @@index([sourceType, sourceId])
  @@map("billing_usage_event")
}

model Store {
  id          String      @id @default(uuid())
  workspaceId String
  name        String
  timezone    String      @default("Europe/Istanbul")
  status      StoreStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace                    Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members                      StoreMember[]
  invitationAccesses           WorkspaceInvitationStoreAccess[]
  channelConnections           ChannelConnection[]
  products                     Product[]
  productIdentities            ProductIdentity[]
  incomingEvents               IncomingEvent[]
  productQuestions             ProductQuestion[]
  questionAnswers              QuestionAnswer[]
  aiDraftAttempts              AiDraftAttempt[]
  knowledgeProfile             StoreKnowledgeProfile?
  knowledgeFaqs                StoreKnowledgeFaq[]
  aiInstructions               StoreAiInstruction[]
  channelKnowledge             ChannelKnowledgeOverride[]
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  notificationDeliverySettings NotificationDeliverySetting[]

  @@map("store")
}

enum AiTone {
  PROFESSIONAL
  FRIENDLY
  WARM
  MINIMAL
}

enum AiResponseLength {
  SHORT
  BALANCED
  DETAILED
}

enum AiEmojiPolicy {
  NEVER
  WHEN_APPROPRIATE
  ALWAYS
}

enum AiAutomationMode {
  OFF
  SHADOW
  SAFE_AUTO
}

model StoreKnowledgeProfile {
  storeId                   String           @id
  brandDescription          String?
  shippingPolicy            String?
  returnPolicy              String?
  exchangePolicy            String?
  warrantyPolicy            String?
  additionalInformation     String?
  tone                      AiTone           @default(PROFESSIONAL)
  responseLength            AiResponseLength @default(BALANCED)
  greetingEnabled           Boolean          @default(true)
  closingEnabled            Boolean          @default(true)
  emojiPolicy               AiEmojiPolicy    @default(NEVER)
  preferredEmoji            String?
  automationMode            AiAutomationMode @default(OFF)
  minimumAutoSendConfidence Float            @default(0.85)
  // Kept temporarily so existing checkbox preferences can be migrated safely.
  emojiEnabled              Boolean          @default(false)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_knowledge_profile")
}

model StoreKnowledgeFaq {
  id        String   @id @default(uuid())
  storeId   String
  question  String
  answer    String
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, active, position])
  @@map("store_knowledge_faq")
}

model StoreAiInstruction {
  id        String   @id @default(uuid())
  storeId   String
  content   String
  priority  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, active, priority])
  @@map("store_ai_instruction")
}

model ChannelKnowledgeOverride {
  id                    String   @id @default(uuid())
  storeId               String
  providerKey           String
  shippingPolicy        String?
  returnPolicy          String?
  exchangePolicy        String?
  warrantyPolicy        String?
  additionalInformation String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, providerKey])
  @@map("channel_knowledge_override")
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

enum ChannelType {
  COMMERCE
  MESSAGING
  SOCIAL
}

enum ChannelConnectionStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  ERROR
}

enum IntegrationEnvironment {
  SANDBOX
  PRODUCTION
}

model ChannelConnection {
  id                        String                  @id @default(uuid())
  storeId                   String
  providerKey               String                  @map("provider")
  type                      ChannelType
  environment               IntegrationEnvironment  @default(SANDBOX)
  status                    ChannelConnectionStatus @default(PENDING)
  credentialsEncrypted      String?
  credentialSchemaVersion   Int                     @default(1)
  connectedAt               DateTime?
  processingStartedAt       DateTime?
  lastSyncAt                DateTime?
  lastInventorySyncAt       DateTime?
  failureReason             String?
  questionSyncStartedAt     DateTime?
  lastQuestionSyncAt        DateTime?
  questionSyncFailureReason String?
  removedAt                 DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  externalProducts ExternalProduct[]
  syncRuns         CatalogSyncRun[]
  incomingEvents   IncomingEvent[]
  productQuestions ProductQuestion[]
  questionAnswers  QuestionAnswer[]

  @@unique([storeId, providerKey])
  @@index([storeId, status])
  @@index([storeId, removedAt])
  @@map("channel_connection")
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum ProductVariantStatus {
  ACTIVE
  OUT_OF_STOCK
  UNAVAILABLE
  ARCHIVED
}

enum SizeGuideStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ProductIdentityType {
  MODEL_CODE
  GTIN
}

model Product {
  id          String        @id @default(uuid())
  storeId     String
  title       String
  description String?
  brand       String?
  category    String?
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  store            Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants         ProductVariant[]
  attributes       ProductAttribute[]
  images           ProductImage[]
  sizeGuides       ProductSizeGuide[]
  externalProducts ExternalProduct[]
  identities       ProductIdentity[]
  questions        ProductQuestion[]

  @@index([storeId, status])
  @@map("product")
}

model ProductIdentity {
  id        String              @id @default(uuid())
  storeId   String
  productId String
  type      ProductIdentityType
  value     String
  createdAt DateTime            @default(now())

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, type, value])
  @@index([productId])
  @@map("product_identity")
}

model ProductVariant {
  id              String               @id @default(uuid())
  productId       String
  title           String?
  sku             String
  barcode         String?
  color           String?
  size            String?
  price           Decimal              @db.Decimal(12, 2)
  currency        String               @default("TRY")
  stock           Int                  @default(0)
  status          ProductVariantStatus @default(ACTIVE)
  sourceUpdatedAt DateTime?
  lastSyncedAt    DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  product          Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  externalVariants ExternalProductVariant[]

  @@index([productId, sku])
  @@index([barcode])
  @@map("product_variant")
}

model ProductAttribute {
  id        String   @id @default(uuid())
  productId String
  name      String
  value     String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name, value])
  @@map("product_attribute")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, url])
  @@map("product_image")
}

model ProductSizeGuide {
  id                String          @id @default(uuid())
  productId         String
  externalProductId String?         @unique
  sourceUrl         String
  status            SizeGuideStatus @default(PENDING)
  rawText           String?
  normalizedText    String?
  structuredData    Json?
  confidence        Float?
  failureReason     String?
  analyzedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  externalProduct ExternalProduct? @relation(fields: [externalProductId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([sourceUrl, status])
  @@map("product_size_guide")
}

model ExternalProduct {
  id              String               @id @default(uuid())
  connectionId    String
  productId       String
  externalId      String
  externalUrl     String?
  rawPayload      Json?
  status          ExternalEntityStatus @default(ACTIVE)
  lastSeenSyncId  String?
  sourceUpdatedAt DateTime?
  lastSyncedAt    DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  connection ChannelConnection        @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  product    Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants   ExternalProductVariant[]
  questions  ProductQuestion[]
  sizeGuide  ProductSizeGuide?

  @@unique([connectionId, externalId])
  @@index([productId])
  @@map("external_product")
}

enum ExternalEntityStatus {
  ACTIVE
  ARCHIVED
  UNAVAILABLE
}

model ExternalProductVariant {
  id                String               @id @default(uuid())
  externalProductId String
  productVariantId  String
  externalId        String
  sku               String
  barcode           String?
  status            ExternalEntityStatus @default(ACTIVE)
  lastSeenSyncId    String?
  sourceUpdatedAt   DateTime?
  lastSyncedAt      DateTime             @default(now())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  externalProduct ExternalProduct @relation(fields: [externalProductId], references: [id], onDelete: Cascade)
  productVariant  ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([externalProductId, externalId])
  @@index([productVariantId])
  @@index([barcode])
  @@index([sku])
  @@map("external_product_variant")
}

enum CatalogSyncStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum CatalogSyncKind {
  FULL
  INVENTORY
  QUESTION
}

enum CatalogSyncTrigger {
  MANUAL
  SCHEDULED
  RETRY
  ONBOARDING
}

enum CatalogSyncStage {
  QUEUED
  FETCHING
  PERSISTING
  RECONCILING
  COMPLETED
  FAILED
}

model CatalogSyncRun {
  id                 String             @id @default(uuid())
  connectionId       String
  kind               CatalogSyncKind    @default(FULL)
  status             CatalogSyncStatus  @default(RUNNING)
  trigger            CatalogSyncTrigger @default(MANUAL)
  stage              CatalogSyncStage   @default(QUEUED)
  progress           Int                @default(0)
  retryOfId          String?
  productsProcessed  Int                @default(0)
  productsCreated    Int                @default(0)
  productsUpdated    Int                @default(0)
  productsUnchanged  Int                @default(0)
  variantsProcessed  Int                @default(0)
  variantsUpdated    Int                @default(0)
  variantsUnchanged  Int                @default(0)
  questionsProcessed Int                @default(0)
  questionsUnchanged Int                @default(0)
  productsArchived   Int                @default(0)
  cursor             String?
  errorMessage       String?
  startedAt          DateTime           @default(now())
  completedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
  @@index([retryOfId])
  @@map("catalog_sync_run")
}

enum IncomingEventType {
  PRODUCT_QUESTION
}

enum IncomingEventProcessingStatus {
  PENDING
  PROCESSED
  IGNORED
  FAILED
}

model IncomingEvent {
  id                String                        @id @default(uuid())
  storeId           String
  connectionId      String
  externalEventId   String
  eventType         IncomingEventType
  externalCreatedAt DateTime
  receivedAt        DateTime                      @default(now())
  processingStatus  IncomingEventProcessingStatus @default(PENDING)
  ignoreReason      String?
  errorMessage      String?
  payload           Json
  processedAt       DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  question   ProductQuestion?

  @@unique([connectionId, externalEventId])
  @@index([storeId, processingStatus, receivedAt])
  @@index([connectionId, externalCreatedAt])
  @@map("incoming_event")
}

enum ProductQuestionStatus {
  PENDING
  DRAFTED
  ANSWERED
  IGNORED
}

enum QuestionReplyDecision {
  READY_FOR_SEND
  NEEDS_REVIEW
  DO_NOT_REPLY
}

enum QuestionAnswerStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
}

enum QuestionAnswerOrigin {
  MANUAL
  AUTOMATION
}

enum QuestionDraftProcessingStatus {
  BLOCKED_QUOTA
  BLOCKED_SUBSCRIPTION
  QUEUED
  PROCESSING
  FAILED
}

enum AiDraftTrigger {
  MANUAL
  AUTOMATION
}

enum AiDraftOutcome {
  AVAILABLE
  SUPERSEDED
  SELECTED
  SENT
  FAILED
}

enum QuestionAnswerComposition {
  MANUAL
  AI_UNCHANGED
  AI_EDITED
}

model ProductQuestion {
  id                       String                         @id @default(uuid())
  storeId                  String
  connectionId             String
  incomingEventId          String                         @unique
  productId                String?
  externalProductRecordId  String?
  externalQuestionId       String
  externalProductId        String
  externalCustomerId       String?
  customerName             String?
  productTitleSnapshot     String?
  productImageUrlSnapshot  String?
  question                 String
  status                   ProductQuestionStatus          @default(PENDING)
  answer                   String?
  draftDecision            QuestionReplyDecision?
  draftConfidence          Float?
  draftAnswerability       String?
  draftRisks               Json?
  draftMissingInformation  Json?
  draftEvidenceIds         Json?
  draftModel               String?
  draftedAt                DateTime?
  draftProcessingStatus    QuestionDraftProcessingStatus?
  draftProcessingError     String?
  draftQueuedAt            DateTime?
  draftProcessingStartedAt DateTime?
  externalCreatedAt        DateTime
  answeredAt               DateTime?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt

  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connection      ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  incomingEvent   IncomingEvent     @relation(fields: [incomingEventId], references: [id], onDelete: Cascade)
  product         Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  externalProduct ExternalProduct?  @relation(fields: [externalProductRecordId], references: [id], onDelete: SetNull)
  answerDelivery  QuestionAnswer?
  draftAttempts   AiDraftAttempt[]

  @@unique([connectionId, externalQuestionId])
  @@index([storeId, status, externalCreatedAt])
  @@index([storeId, draftDecision])
  @@index([storeId, draftProcessingStatus])
  @@index([productId])
  @@index([externalProductRecordId])
  @@map("product_question")
}

model AiDraftAttempt {
  id                         String                @id @default(uuid())
  storeId                    String
  questionId                 String
  requestedByUserId          String?
  trigger                    AiDraftTrigger
  outcome                    AiDraftOutcome        @default(AVAILABLE)
  answer                     String
  decision                   QuestionReplyDecision
  confidence                 Float
  answerability              String
  risks                      Json
  missingInformation         Json
  evidenceIds                Json
  model                      String
  interpretation             String?
  requestedFacts             Json?
  detectedFacts              Json?
  automationMode             AiAutomationMode      @default(OFF)
  autoSendEligible           Boolean               @default(false)
  appliedConfidenceThreshold Float                 @default(0.85)
  eligibilityReasons         Json                  @default("[]")
  inventorySnapshotHash      String?
  selectedAt                 DateTime?
  finalizedAt                DateTime?
  createdAt                  DateTime              @default(now())

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  question       ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  requestedBy    User?           @relation("AiDraftRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  answerDelivery QuestionAnswer?

  @@index([questionId, createdAt])
  @@index([storeId, outcome, createdAt])
  @@map("ai_draft_attempt")
}

model QuestionAnswer {
  id                  String                    @id @default(uuid())
  storeId             String
  connectionId        String
  questionId          String                    @unique
  requestedByUserId   String?
  draftAttemptId      String?                   @unique
  origin              QuestionAnswerOrigin      @default(MANUAL)
  composition         QuestionAnswerComposition @default(MANUAL)
  answer              String
  status              QuestionAnswerStatus      @default(QUEUED)
  externalAnswerId    String?
  attempts            Int                       @default(0)
  lastError           String?
  queuedAt            DateTime                  @default(now())
  processingStartedAt DateTime?
  sentAt              DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  question     ProductQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  requestedBy  User?             @relation("QuestionAnswerRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  draftAttempt AiDraftAttempt?   @relation(fields: [draftAttemptId], references: [id], onDelete: SetNull)

  @@index([storeId, status, queuedAt])
  @@index([connectionId, status])
  @@map("question_answer")
}

model StoreMember {
  id        String    @id @default(uuid())
  storeId   String
  userId    String
  role      StoreRole @default(AGENT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@map("store_member")
}

enum StoreRole {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum NotificationType {
  BILLING_PAYMENT_ISSUE
  AI_REVIEW_REQUIRED
  AI_DRAFT_FAILED
  AI_USAGE_LIMIT
  ANSWER_DELIVERY_FAILED
  PRODUCT_SYNC_FAILED
  QUESTION_SYNC_FAILED
  LOW_STOCK
  OUT_OF_STOCK
  CHANNEL_CONNECTION_ERROR
  BILLING_PLAN_LIMIT
}

enum NotificationSeverity {
  INFO
  WARNING
  ERROR
}

model Notification {
  id              String               @id @default(uuid())
  recipientUserId String
  storeId         String?
  type            NotificationType
  severity        NotificationSeverity @default(INFO)
  title           String
  message         String
  actionUrl       String?
  entityType      String?
  entityId        String?
  dedupeKey       String?
  occurrenceCount Int                  @default(1)
  readAt          DateTime?
  lastOccurredAt  DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  recipient User   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  store     Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([recipientUserId, dedupeKey])
  @@index([recipientUserId, readAt, lastOccurredAt])
  @@index([storeId, lastOccurredAt])
  @@map("notification")
}

model NotificationPreference {
  id        String           @id @default(uuid())
  userId    String
  storeId   String
  type      NotificationType
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId, type])
  @@index([storeId, type])
  @@map("notification_preference")
}

model NotificationDeliverySetting {
  id                String   @id @default(uuid())
  userId            String
  storeId           String
  browserEnabled    Boolean  @default(false)
  emailEnabled      Boolean  @default(false)
  quietHoursEnabled Boolean  @default(false)
  quietHoursStart   String   @default("22:00")
  quietHoursEnd     String   @default("08:00")
  timezone          String   @default("Europe/Istanbul")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
  @@map("notification_delivery_setting")
}

model WebPushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("web_push_subscription")
}
