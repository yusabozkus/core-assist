datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

model User {
  id                            String                         @id @default(uuid())
  name                          String
  email                         String                         @unique
  emailVerified                 Boolean                        @default(false)
  image                         String?
  onboardingCompletedAt         DateTime?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  sessions                      Session[]
  accounts                      Account[]
  ownedWorkspace                Workspace?                     @relation("WorkspaceOwner")
  workspaceMembers              WorkspaceMember[]
  storeMembers                  StoreMember[]
  requestedQuestionAnswers      QuestionAnswer[]               @relation("QuestionAnswerRequester")
  requestedAiDrafts             AiDraftAttempt[]               @relation("AiDraftRequester")
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  notificationDeliverySettings  NotificationDeliverySetting[]
  notificationEmailDigestStates NotificationEmailDigestState[]
  emailDeliveryRecords          EmailDeliveryRecord[]
  syncEmailIncidentDeliveries   SyncEmailIncidentDelivery[]
  operationalEmailDeliveries    OperationalEmailDelivery[]
  webPushSubscriptions          WebPushSubscription[]
  billingCheckouts              BillingCheckout[]
  billingPlanChanges            BillingPlanChange[]
  sentWorkspaceInvitations      WorkspaceInvitation[]          @relation("WorkspaceInvitationSender")
  verifiedProductKnowledgeFacts ProductKnowledgeFact[]         @relation("ProductKnowledgeVerifier")
  createdSupportTickets         SupportTicket[]                @relation("SupportTicketCreator")
  assignedSupportTickets        SupportTicket[]                @relation("SupportTicketAssignee")
  supportMessages               SupportMessage[]               @relation("SupportMessageAuthor")

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

enum AuditOrigin {
  API
  WORKER
  WEBHOOK
  SCHEDULED
  SYSTEM
}

enum AuditResult {
  STARTED
  SUCCESS
  FAILURE
}

// Append-only operational evidence. Deliberately has no foreign keys so that
// account/workspace deletion cannot erase the administrative history.
model AuditLog {
  id          String         @id @default(uuid())
  actorType   AuditActorType
  actorUserId String?
  actorName   String?
  actorEmail  String?
  origin      AuditOrigin
  action      String
  result      AuditResult
  workspaceId String?
  storeId     String?
  targetType  String?
  targetId    String?
  requestId   String?
  ipAddress   String?
  userAgent   String?
  errorCode   String?
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([createdAt])
  @@index([workspaceId, createdAt])
  @@index([storeId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([result, createdAt])
  @@map("audit_log")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  ownerId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner                        User                          @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members                      WorkspaceMember[]
  stores                       Store[]
  billingSubscription          BillingSubscription?
  billingUsagePeriods          BillingUsagePeriod[]
  billingUsageEvents           BillingUsageEvent[]
  billingCheckouts             BillingCheckout[]
  billingPlanChanges           BillingPlanChange[]
  billingTransactionReferences BillingTransactionReference[]
  invitations                  WorkspaceInvitation[]
  supportTickets               SupportTicket[]
  emailDeliveryRecords         EmailDeliveryRecord[]
  aiDraftLease                 AiDraftLease?

  @@map("workspace")
}

model AiDraftLease {
  workspaceId String @id
  questionId  String
  token       String
  expiresAt   DateTime
  startedAt   DateTime
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("ai_draft_lease")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@unique([workspaceId, userId])
  @@map("workspace_member")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model WorkspaceInvitation {
  id              String                    @id @default(uuid())
  workspaceId     String
  email           String
  emailNormalized String
  role            WorkspaceRole             @default(MEMBER)
  tokenHash       String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace     Workspace                        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy     User?                            @relation("WorkspaceInvitationSender", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  storeAccesses WorkspaceInvitationStoreAccess[]

  @@index([workspaceId, status, expiresAt])
  @@index([emailNormalized, status])
  @@map("workspace_invitation")
}

model WorkspaceInvitationStoreAccess {
  invitationId String
  storeId      String
  role         StoreRole @default(AGENT)
  createdAt    DateTime  @default(now())

  invitation WorkspaceInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  store      Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([invitationId, storeId])
  @@index([storeId])
  @@map("workspace_invitation_store_access")
}

enum BillingPlan {
  STARTER
  GROWTH
  BUSINESS
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum BillingSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}

enum BillingUsageMetric {
  AI_QUESTION
}

model BillingSubscription {
  id                    String                    @id @default(uuid())
  workspaceId           String                    @unique
  plan                  BillingPlan               @default(STARTER)
  cycle                 BillingCycle              @default(MONTHLY)
  status                BillingSubscriptionStatus @default(TRIALING)
  paddleCustomerId      String?                   @unique
  paddleSubscriptionId  String?                   @unique
  paddlePriceId         String?
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  trialEndsAt           DateTime?
  cancelAtPeriodEnd     Boolean                   @default(false)
  canceledAt            DateTime?
  paddleUpdatedAt       DateTime?
  paddleSnapshotAt      DateTime?
  scheduledAccessEndsAt DateTime?
  lastReconciledAt      DateTime?
  reconcileAfter        DateTime                  @default(now())
  reconcileFailures     Int                       @default(0)
  reconcileErrorCode    String?
  usagePeriodAnchor     DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usagePeriods BillingUsagePeriod[]

  @@index([status, currentPeriodEnd])
  @@index([reconcileAfter])
  @@map("billing_subscription")
}

model BillingWebhookEvent {
  id          String   @id
  eventType   String
  occurredAt  DateTime
  processedAt DateTime @default(now())

  @@index([eventType, occurredAt])
  @@index([processedAt])
  @@map("billing_webhook_event")
}

// Searchable Paddle identifiers for initial and recurring transactions.
// Payment payloads, amounts and payment-method data are deliberately excluded.
model BillingTransactionReference {
  id                   String            @id @default(uuid())
  workspaceId          String
  environment          PaddleEnvironment
  paddleTransactionId  String
  paddleSubscriptionId String?
  paddleCustomerId     String?
  origin               String?
  occurredAt           DateTime
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([environment, paddleTransactionId], map: "billing_tx_ref_environment_transaction_key")
  @@index([workspaceId, occurredAt])
  @@index([environment, paddleSubscriptionId], map: "billing_tx_ref_environment_subscription_idx")
  @@index([environment, paddleCustomerId])
  @@index([updatedAt])
  @@map("billing_transaction_reference")
}

// Minimal financial closure evidence survives account/workspace deletion.
// No user relation, profile, payment credentials, or raw Paddle payloads.
model BillingClosureRecord {
  id                    String            @id @default(uuid())
  workspaceReference    String            @unique
  environment           PaddleEnvironment
  paddleSubscriptionIds String[]
  paddleCustomerIds     String[]
  billingSnapshot       Json
  closedAt              DateTime          @default(now())

  @@index([paddleSubscriptionIds], type: Gin)
  @@map("billing_closure_record")
}

enum PaddleEnvironment {
  SANDBOX
  PRODUCTION
}

enum BillingCheckoutStatus {
  CREATING
  OPEN
  REVIEW_REQUIRED
  COMPLETED
  CANCELED
  FAILED
}

model BillingCheckout {
  id                           String                @id @default(uuid())
  workspaceId                  String
  requestedByUserId            String?
  environment                  PaddleEnvironment
  status                       BillingCheckoutStatus @default(CREATING)
  plan                         BillingPlan
  cycle                        BillingCycle
  paddlePriceId                String
  paddleTransactionId          String?               @unique
  expectedPaddleCustomerId     String?
  previousPaddleSubscriptionId String?
  paddleSubscriptionId         String?               @unique
  boundAt                      DateTime?
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedByUser User?     @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([status, updatedAt])
  // A SQL partial unique index permits only one unresolved checkout per workspace.
  @@index([requestedByUserId])
  @@map("billing_checkout")
}

enum BillingPlanChangeStatus {
  PREVIEWED
  PROCESSING
  RETRY_SCHEDULED
  AWAITING_WEBHOOK
  COMPLETED
  FAILED
  REVIEW_REQUIRED
}

model BillingPlanChange {
  id                   String                  @id @default(uuid())
  workspaceId          String
  requestedByUserId    String?
  environment          PaddleEnvironment
  status               BillingPlanChangeStatus @default(PREVIEWED)
  paddleSubscriptionId String
  paddleCustomerId     String
  sourcePriceId        String
  sourceUpdatedAt      DateTime
  sourceFingerprint    String
  targetPriceId        String
  plan                 BillingPlan
  cycle                BillingCycle
  preview              Json
  expiresAt            DateTime
  submittedAt          DateTime?
  retryAfterSeconds    Int?
  retryAt              DateTime?
  retryCount           Int                     @default(0)
  completedAt          DateTime?
  failureCode          String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedByUser User?     @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([requestedByUserId])
  @@index([status, retryAt])
  @@index([status, expiresAt])
  @@index([status, updatedAt])
  // A partial unique index serializes submitted changes, not read-only previews.
  @@map("billing_plan_change")
}

model BillingUsagePeriod {
  id              String   @id @default(uuid())
  workspaceId     String
  subscriptionId  String?
  periodStart     DateTime
  periodEnd       DateTime
  aiQuestionUnits Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  events       BillingUsageEvent[]

  @@unique([workspaceId, periodStart])
  @@index([workspaceId, periodEnd])
  @@index([subscriptionId])
  @@map("billing_usage_period")
}

model BillingUsageEvent {
  id             String             @id @default(uuid())
  workspaceId    String
  usagePeriodId  String
  metric         BillingUsageMetric
  quantity       Int                @default(1)
  idempotencyKey String
  sourceType     String?
  sourceId       String?
  metadata       Json?
  createdAt      DateTime           @default(now())

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usagePeriod BillingUsagePeriod @relation(fields: [usagePeriodId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([usagePeriodId, metric, createdAt])
  @@index([metric, createdAt])
  @@index([sourceType, sourceId])
  @@map("billing_usage_event")
}

model Store {
  id              String           @id @default(uuid())
  workspaceId     String
  name            String
  timezone        String           @default("Europe/Istanbul")
  status          StoreStatus      @default(ACTIVE)
  inventoryPolicy InventoryPolicy?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  workspace                     Workspace                        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members                       StoreMember[]
  invitationAccesses            WorkspaceInvitationStoreAccess[]
  channelConnections            ChannelConnection[]
  products                      Product[]
  productIdentities             ProductIdentity[]
  incomingEvents                IncomingEvent[]
  productQuestions              ProductQuestion[]
  questionAnswers               QuestionAnswer[]
  aiDraftAttempts               AiDraftAttempt[]
  knowledgeProfile              StoreKnowledgeProfile?
  knowledgeFaqs                 StoreKnowledgeFaq[]
  aiInstructions                StoreAiInstruction[]
  channelKnowledge              ChannelKnowledgeOverride[]
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  notificationDeliverySettings  NotificationDeliverySetting[]
  notificationEmailDigestStates NotificationEmailDigestState[]
  emailDeliveryRecords          EmailDeliveryRecord[]
  operationalEmailIncidents     OperationalEmailIncident[]
  productKnowledgeFacts         ProductKnowledgeFact[]
  supportTickets                SupportTicket[]

  @@map("store")
}

enum AiTone {
  PROFESSIONAL
  FRIENDLY
  WARM
  MINIMAL
}

enum AiResponseLength {
  SHORT
  BALANCED
  DETAILED
}

enum AiEmojiPolicy {
  NEVER
  WHEN_APPROPRIATE
  ALWAYS
}

enum AiAutomationMode {
  OFF
  SHADOW
  SAFE_AUTO
}

model StoreKnowledgeProfile {
  storeId                               String           @id
  brandDescription                      String?
  shippingPolicy                        String?
  returnPolicy                          String?
  exchangePolicy                        String?
  warrantyPolicy                        String?
  additionalInformation                 String?
  tone                                  AiTone           @default(PROFESSIONAL)
  responseLength                        AiResponseLength @default(BALANCED)
  greetingEnabled                       Boolean          @default(true)
  closingEnabled                        Boolean          @default(true)
  heightWeightSizeRecommendationEnabled Boolean          @default(false)
  emojiPolicy                           AiEmojiPolicy    @default(NEVER)
  preferredEmoji                        String?
  automationMode                        AiAutomationMode @default(OFF)
  minimumAutoSendConfidence             Float            @default(0.85)
  // Kept temporarily so existing checkbox preferences can be migrated safely.
  emojiEnabled                          Boolean          @default(false)
  createdAt                             DateTime         @default(now())
  updatedAt                             DateTime         @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_knowledge_profile")
}

model StoreKnowledgeFaq {
  id        String   @id @default(uuid())
  storeId   String
  question  String
  answer    String
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, active, position])
  @@map("store_knowledge_faq")
}

model StoreAiInstruction {
  id        String   @id @default(uuid())
  storeId   String
  content   String
  priority  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, active, priority])
  @@map("store_ai_instruction")
}

model ChannelKnowledgeOverride {
  id                    String   @id @default(uuid())
  storeId               String
  providerKey           String
  shippingPolicy        String?
  returnPolicy          String?
  exchangePolicy        String?
  warrantyPolicy        String?
  additionalInformation String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, providerKey])
  @@map("channel_knowledge_override")
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

enum InventoryPolicy {
  SHARED
  CHANNEL_SPECIFIC
}

enum ChannelType {
  COMMERCE
  MESSAGING
  SOCIAL
}

enum ChannelConnectionStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  ERROR
}

enum IntegrationEnvironment {
  SANDBOX
  PRODUCTION
}

model ChannelConnection {
  id                        String                  @id @default(uuid())
  storeId                   String
  providerKey               String                  @map("provider")
  type                      ChannelType
  environment               IntegrationEnvironment  @default(SANDBOX)
  status                    ChannelConnectionStatus @default(PENDING)
  credentialsEncrypted      String?
  credentialSchemaVersion   Int                     @default(1)
  connectedAt               DateTime?
  processingStartedAt       DateTime?
  lastSyncAt                DateTime?
  lastInventorySyncAt       DateTime?
  failureReason             String?
  questionSyncStartedAt     DateTime?
  lastQuestionSyncAt        DateTime?
  questionSyncFailureReason String?
  removedAt                 DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  externalProducts   ExternalProduct[]
  syncRuns           CatalogSyncRun[]
  syncEmailIncidents SyncEmailIncident[]
  incomingEvents     IncomingEvent[]
  productQuestions   ProductQuestion[]
  questionAnswers    QuestionAnswer[]

  @@unique([storeId, providerKey])
  @@index([storeId, status])
  @@index([storeId, removedAt])
  @@map("channel_connection")
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum ProductVariantStatus {
  ACTIVE
  OUT_OF_STOCK
  UNAVAILABLE
  ARCHIVED
}

enum SizeGuideStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ProductIdentityType {
  MODEL_CODE
  GTIN
}

model Product {
  id          String        @id @default(uuid())
  storeId     String
  title       String
  description String?
  brand       String?
  category    String?
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  store            Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants         ProductVariant[]
  attributes       ProductAttribute[]
  images           ProductImage[]
  sizeGuides       ProductSizeGuide[]
  externalProducts ExternalProduct[]
  identities       ProductIdentity[]
  questions        ProductQuestion[]
  knowledgeFacts   ProductKnowledgeFact[]

  @@index([storeId, status])
  @@map("product")
}

model ProductIdentity {
  id        String              @id @default(uuid())
  storeId   String
  productId String
  type      ProductIdentityType
  value     String
  createdAt DateTime            @default(now())

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, type, value])
  @@index([productId])
  @@map("product_identity")
}

model ProductVariant {
  id              String               @id @default(uuid())
  productId       String
  title           String?
  sku             String
  barcode         String?
  color           String?
  size            String?
  price           Decimal              @db.Decimal(12, 2)
  currency        String               @default("TRY")
  stock           Int                  @default(0)
  status          ProductVariantStatus @default(ACTIVE)
  sourceUpdatedAt DateTime?
  lastSyncedAt    DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  product          Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  externalVariants ExternalProductVariant[]
  knowledgeFacts   ProductKnowledgeFact[]

  @@index([productId, sku])
  @@index([barcode])
  @@map("product_variant")
}

model ProductAttribute {
  id        String   @id @default(uuid())
  productId String
  name      String
  value     String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name, value])
  @@map("product_attribute")
}

enum ProductKnowledgeFactType {
  MATERIAL
  DURABILITY
  SIZE
  COLOR
  FIT
  CARE
  PRODUCT_INFO
}

enum ProductKnowledgeFactStatus {
  VERIFIED
  CONFLICT
  ARCHIVED
}

model ProductKnowledgeFact {
  id                    String                     @id @default(uuid())
  storeId               String
  productId             String
  variantId             String?
  scopeKey              String
  factType              ProductKnowledgeFactType
  normalizedKey         String
  label                 String
  value                 String
  status                ProductKnowledgeFactStatus @default(VERIFIED)
  verifiedByUserId      String?
  originatingQuestionId String?
  verifiedAt            DateTime                   @default(now())
  archivedAt            DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  store               Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product             Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant             ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  verifiedBy          User?            @relation("ProductKnowledgeVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  originatingQuestion ProductQuestion? @relation("ProductKnowledgeOriginQuestion", fields: [originatingQuestionId], references: [id], onDelete: SetNull)

  @@unique([productId, scopeKey, normalizedKey])
  @@index([storeId, status, updatedAt])
  @@index([productId, status])
  @@index([variantId, status])
  @@map("product_knowledge_fact")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, url])
  @@map("product_image")
}

model ProductSizeGuide {
  id                String          @id @default(uuid())
  productId         String
  externalProductId String?         @unique
  sourceUrl         String
  status            SizeGuideStatus @default(PENDING)
  rawText           String?
  normalizedText    String?
  structuredData    Json?
  confidence        Float?
  failureReason     String?
  analyzedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  externalProduct ExternalProduct? @relation(fields: [externalProductId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([sourceUrl, status])
  @@map("product_size_guide")
}

model ExternalProduct {
  id              String               @id @default(uuid())
  connectionId    String
  productId       String
  externalId      String
  externalUrl     String?
  rawPayload      Json?
  status          ExternalEntityStatus @default(ACTIVE)
  lastSeenSyncId  String?
  sourceUpdatedAt DateTime?
  lastSyncedAt    DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  connection ChannelConnection        @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  product    Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants   ExternalProductVariant[]
  questions  ProductQuestion[]
  sizeGuide  ProductSizeGuide?

  @@unique([connectionId, externalId])
  @@index([productId])
  @@map("external_product")
}

enum ExternalEntityStatus {
  ACTIVE
  ARCHIVED
  UNAVAILABLE
}

enum StockEmailAlertLevel {
  LOW_STOCK
  OUT_OF_STOCK
}

model ExternalProductVariant {
  id                       String                @id @default(uuid())
  externalProductId        String
  productVariantId         String
  externalId               String
  sku                      String
  barcode                  String?
