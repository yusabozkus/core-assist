PORT=4001
# Production builds: production (default) or staging (explicit sandbox testing).
# Both require live marketplace connector modes; only staging permits Paddle sandbox.
DEPLOYMENT_ENV="production"
DATABASE_URL=""

# Production defaults to JSON/info; development defaults to pretty/debug.
# LOG_LEVEL: fatal | error | warn | info | debug | verbose
LOG_LEVEL=""
# LOG_FORMAT: json | pretty
LOG_FORMAT=""
LOG_SERVICE_NAME="core-asistan-api"
TRUST_PROXY_HOPS="1"

BETTER_AUTH_SECRET=""
# Production: https://api.coreasistan.com
BETTER_AUTH_URL=""

# Production: https://coreasistan.com
FRONTEND_URL=""

# Leave empty for localhost or same-host deployment.
# Required for https://coreasistan.com + https://api.coreasistan.com:
# AUTH_COOKIE_DOMAIN="coreasistan.com"
# Every subdomain within this cookie scope must be trusted.
AUTH_COOKIE_DOMAIN=""

# Comma-separated, exact and verified email addresses for the internal admin panel.
ADMIN_EMAILS=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional Microsoft sign-in. Set both credentials to enable the provider.
# Entra app registration > Web redirect URI:
# http://localhost:4001/api/auth/callback/microsoft
# Production: https://api.coreasistan.com/api/auth/callback/microsoft
# Use the client secret VALUE, not its Secret ID. Keep it backend-only.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# common accepts personal Microsoft accounts and work/school accounts.
MICROSOFT_TENANT_ID="common"

# openssl rand -base64 32
INTEGRATION_CREDENTIALS_KEY=""

# mock | live
CATALOG_CONNECTOR_MODE="mock"
QUESTION_CONNECTOR_MODE="mock"
# Snapshot-based mock catalog: 30 products per provider, 100 products/page by default.
MOCK_CATALOG_PAGE_SIZE="100"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_SIZE_GUIDE_MODEL="gemini-3.5-flash-lite"
GEMINI_REQUEST_TIMEOUT_MS="10000"
# Temporary AI test endpoint: available in development; opt in for production-mode staging only.
# Remove the endpoint and this flag before production launch.
AI_TEST_ENABLED="false"

# Comma-separated marketplace image CDN allowlist for size-guide extraction.
SIZE_GUIDE_ALLOWED_HOSTS="cdn.dsmcdn.com,productimages.hepsiburada.net"
SIZE_GUIDE_MAX_IMAGE_BYTES="8388608"

REDIS_URL="redis://localhost:6379"
INVENTORY_SYNC_INTERVAL_MS="300000"
# Stock evidence older than this is blocked from safe automatic answers.
INVENTORY_FRESHNESS_MAX_AGE_MS="900000"
QUESTION_SYNC_INTERVAL_MS="120000"

# Read notifications older than this are removed automatically.
NOTIFICATION_RETENTION_DAYS="90"
NOTIFICATION_CLEANUP_INTERVAL_MS="86400000"
AI_REVIEW_DIGEST_INTERVAL_MS="28800000"
SUPPORT_SLA_CHECK_INTERVAL_MS="60000"

# Private Backblaze B2 bucket for support ticket images (PNG/JPEG/WebP, max 3 x 5 MB).
# Use the S3 endpoint shown in B2, e.g. https://s3.eu-central-003.backblazeb2.com.
# The application key needs listFiles, readFiles, writeFiles and deleteFiles for this bucket.
SUPPORT_B2_ENDPOINT=""
SUPPORT_B2_REGION=""
SUPPORT_B2_BUCKET=""
SUPPORT_B2_KEY_ID=""
SUPPORT_B2_APPLICATION_KEY=""

# Operational data retention. Cleanup runs in bounded batches once per day.
DATA_RETENTION_AUDIT_LOG_DAYS="365"
DATA_RETENTION_COMPLETED_SYNC_RUN_DAYS="90"
DATA_RETENTION_FAILED_SYNC_RUN_DAYS="180"
DATA_RETENTION_RESOLVED_SUPPORT_TICKET_DAYS="365"
DATA_RETENTION_CLOSED_SUPPORT_TICKET_DAYS="365"
DATA_RETENTION_ARCHIVED_CONTACT_MESSAGE_DAYS="730"
DATA_RETENTION_CLEANUP_INTERVAL_MS="86400000"

# Optional browser push notifications. Generate keys with:
# npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_VAPID_SUBJECT="mailto:support@coreasistan.com"

# Resend email delivery. Set both values to enable outgoing notifications.
# The sender address must use a domain verified in your Resend account.
RESEND_API_KEY=""
# Resend webhook signing secret for /notifications/webhooks/resend.
RESEND_WEBHOOK_SECRET=""
NOTIFICATION_EMAIL_FROM="Core Asistan <notifications@coreasistan.com>"

# Paddle Billing. Use sandbox credentials while PADDLE_ENV is sandbox.
PADDLE_ENV="sandbox"
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_PRICE_STARTER_MONTHLY=""
PADDLE_PRICE_STARTER_ANNUAL=""
PADDLE_PRICE_GROWTH_MONTHLY=""
PADDLE_PRICE_GROWTH_ANNUAL=""
PADDLE_PRICE_BUSINESS_MONTHLY=""
PADDLE_PRICE_BUSINESS_ANNUAL=""

# Local billing limit testing only. Never enable in production.
# When enabled, omitted values use 10 questions, 1 store, 2 members and 5 products.
BILLING_TEST_LIMITS_ENABLED="false"
BILLING_TEST_AI_QUESTIONS="10"
BILLING_TEST_STORES="1"
BILLING_TEST_MEMBERS="2"
BILLING_TEST_PRODUCTS="5"
