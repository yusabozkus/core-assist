{
  "name": "frontend",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "check": "npm run lint && npm test && npm run build",
    "test:security": "node --test scripts/security-config.test.mjs",
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
